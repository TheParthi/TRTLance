# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for verified escrow events, wallet linking and AI output.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# --- Escrow network (leave empty to run without on-chain escrow; the UI says so) ---
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_NATIVE_SYMBOL=SHM
NEXT_PUBLIC_ESCROW_ADDRESS=
# Optional private RPC for server-side verification, and confirmations required.
ESCROW_RPC_URL=
ESCROW_CONFIRMATIONS=1

# --- AI (Google Gemini via Genkit) ---
GEMINI_API_KEY=
AI_MODEL=googleai/gemini-2.5-flash

# --- Contract deployment (blockchain/) — separate keys per network ---
TESTNET_DEPLOYER_PRIVATE_KEY=
MAINNET_DEPLOYER_PRIVATE_KEY=
ESCROW_ARBITER_ADDRESS=
SHARDEUM_TESTNET_RPC=
SHARDEUM_TESTNET_CHAIN_ID=

# --- Local database tests (Homebrew Postgres) ---
TEST_DATABASE_URL=postgres://localhost:5432/trustlance_test
