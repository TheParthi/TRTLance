# Copy to .env.local and fill in. Never commit .env.local.
# Both the Next.js app and backend/hardhat.config.js read this file.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, keep secret

# --- AI ---
GEMINI_API_KEY=                     # Genkit googleAI plugin (src/ai)
AI_PROVIDER=                        # dispute agent: openai | ollama
OPENAI_API_KEY=
OLLAMA_BASE_URL=
MODEL_NAME=

# --- Smart contracts (backend/) — testnet wallet only ---
DEPLOYER_PRIVATE_KEY=
PLATFORM_ADMIN_ADDRESS=
POLYGON_AMOY_RPC=
POLYGON_RPC=
SEPOLIA_RPC=
POLYGONSCAN_API_KEY=
