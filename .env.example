# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for verified coin payments, scheduled jobs and AI output.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# The console's own origin. One deployment serves both: the middleware lets each origin serve only
# what belongs to it. Locally that is a second port (`npm run dev:admin`); in production a hostname
# such as https://admin.example.com, which also gives the console its own cookie scope.
# Leave it empty to serve the console at /admin on the site itself.
NEXT_PUBLIC_ADMIN_URL=http://localhost:9001

# --- Coin payments ---
# PAYMENTS_PROVIDER=razorpay takes real payments. Leave it empty locally to use test payments
# (no real money; refused in production unless ALLOW_MOCK_PAYMENTS=true).
PAYMENTS_PROVIDER=
ALLOW_MOCK_PAYMENTS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://<site>/api/payments/razorpay/webhook (payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
# Scheduler calls /api/cron/coin-jobs with "Authorization: Bearer <CRON_SECRET>" every 15–60 minutes
# (auto-release of unanswered milestones, end of the 7-working-day hold).
CRON_SECRET=

# --- Platform console (/admin) ---
# Signs the short-lived cookie that says an admin has confirmed their password (see src/lib/admin/seal.ts).
# Optional: falls back to SUPABASE_SERVICE_ROLE_KEY. Set it to a long random string in production —
# rotating it signs every admin out of the console without touching anything else.
ADMIN_SESSION_SECRET=

# --- AI (Google Gemini via Genkit) ---
GEMINI_API_KEY=
AI_MODEL=googleai/gemini-2.5-flash

# --- Local database tests (Homebrew Postgres) ---
TEST_DATABASE_URL=postgres://localhost:5432/trustlance_test

# --- End-to-end tests (optional; the specs skip without them) ---
# A confirmed account listed in platform_admins, and one that is not an admin.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
